            "name": "List group memberships",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/:workspace/groups/:group_token/memberships",
            "params": [
              {
                "name": "workspace",
                "value": "",
                "type": "path",
                "description": "`Workspace` username"
              },
              {
                "name": "group_token",
                "value": "",
                "type": "path",
                "description": "`UserGroup` token"
              }
            ]
          },
          "docs": "Get all `Memberships` of a `Group`"
        },
        {
          "info": {
            "name": "Create a group membership",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/:workspace/groups/:group_token/memberships",
            "params": [
              {
                "name": "workspace",
                "value": "",
                "type": "path",
                "description": "`Workspace` username"
              },
              {
                "name": "group_token",
                "value": "",
                "type": "path",
                "description": "`UserGroup` token"
              }
            ]

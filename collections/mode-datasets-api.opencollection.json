        {
          "info": {
            "name": "List Reports using a Dataset",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/:account/datasets/:dataset/reports",
            "params": [
              {
                "name": "account",
                "value": "",
                "type": "path",
                "description": "`Account` (`Workspace` or `User`) username"
              },
              {
                "name": "dataset",
                "value": "",
                "type": "path",
                "description": "`Dataset` token"
              }
            ]
          },
          "docs": "Returns a list of reports that have imported the `Dataset`"
        },
        {
          "info": {
            "name": "List Dataset runs",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/:account/datasets/:dataset/runs",
            "params": [
              {
                "name": "account",
                "value": "",
                "type": "path",
                "description": "`Account` (`Workspace` or `User`) username"
              },
              {
                "name": "dataset",
                "value": "",
                "type": "path",
                "description": "`Dataset` token"
              },
              {
                "name": "filter",
                "value": "",
                "type": "query",
                "description": "Returns a filtered list of `Run`s for a `Dataset` filtered by whether their `created_at` or `updated_at` timestamps are `gt` (greater than) or `lt` (less than) the datetime passed in ISO8601 format. Example: `?filter=updated_at.lt.2019-10-23T06:23:01Z` returns all `Runs` in a space created before that date."
              },
              {
                "name": "order",
                "value": "",
                "type": "query",
                "description": "With the `order` param, returns all `DatasetRun`s for a `Dataset` ordered by their `created_at` or `updated_at` timestamps"
              },
              {
                "name": "order_by",
                "value": "",
                "type": "query",
                "description": "With the `order_by` param, returns all `DatasetRun`s for a `Dataset` ordered in `asc` or `desc` order"
              }
            ]
          },
          "docs": "Returns a list of `DatasetRun`s for a `Dataset`"
        },
        {
          "info": {
            "name": "Create a Dataset run",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/:account/datasets/:dataset/runs",
            "params": [
              {
                "name": "account",
                "value": "",
                "type": "path",
                "description": "`Account` (`Workspace` or `User`) username"
              },
              {
                "name": "dataset",
                "value": "",
                "type": "path",
                "description": "`Dataset` token"
              }
            ]
          },
          "docs": "Runs a single `Dataset` and returns a representation of the resulting `DatasetRun`"
        },
        {
          "info": {
            "name": "List schedules for a dataset",
            "type": "http"

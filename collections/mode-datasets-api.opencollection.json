        {
          "info": {
            "name": "Get fields for a Dataset",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/:account/datasets/:dataset/fields",
            "params": [
              {
                "name": "account",
                "value": "",
                "type": "path",
                "description": "`Account` (`Workspace` or `User`) username"
              },
              {
                "name": "dataset",
                "value": "",
                "type": "path",
                "description": "`Dataset` token"
              }
            ]
          },
          "docs": "Returns a list of the latest fields for a `Dataset`"
        },
        {
          "info": {
            "name": "Get field descriptions for a Dataset",

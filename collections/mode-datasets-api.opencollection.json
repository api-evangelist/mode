          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/:workspace/datasets/:dataset/schedules",
            "params": [
              {
                "name": "workspace",
                "value": "",
                "type": "path",
                "description": "`Workspace` username"
              },
              {
                "name": "dataset",
                "value": "",
                "type": "path",
                "description": "`Dataset` token"
              }
            ]
          },
          "docs": "Returns all `Schedule`s for a `Dataset`"
        },
